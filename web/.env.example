# Copy to web/.env.local for `pnpm dev`. Every value below is also the built-in default,
# so this file is only needed when the Go services run on other hosts or ports.

# Browser-visible (inlined at build time)
NEXT_PUBLIC_IDENTITY_URL=http://localhost:8081
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# Server-to-server (route handlers under /api/auth). Defaults to the public URLs.
# In docker compose these point at the service names instead.
IDENTITY_URL=http://localhost:8081
CORE_API_URL=http://localhost:8080
