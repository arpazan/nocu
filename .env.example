# Copy to .env for local runs (make run-*) and docker compose.

APP_ENV=development
LOG_LEVEL=debug

# Postgres (compose uses these to create the database)
POSTGRES_USER=nocu
POSTGRES_PASSWORD=nocu
POSTGRES_DB=nocu
POSTGRES_PORT=5432
DATABASE_URL=postgres://nocu:nocu@localhost:5432/nocu?sslmode=disable

# NATS
NATS_URL=nats://localhost:4222

# JWT (shared by identity and core-api; use a long random value in production)
JWT_SECRET=change-me-in-production-please
JWT_ISSUER=nocu-identity
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# HTTP ports. HTTP_PORT is what a locally run service binds; override per terminal
# (e.g. HTTP_PORT=8081 make run-identity). The *_PORT values are host ports for compose.
HTTP_PORT=8080
IDENTITY_PORT=8081
CORE_API_PORT=8080

# identity
IDENTITY_DEFAULT_ROLE=viewer
IDENTITY_MIN_PASSWORD_LENGTH=8

# core-api websocket
WS_WRITE_TIMEOUT=5s
WS_PING_INTERVAL=30s
WS_SEND_BUFFER=64

# consumer
CONSUMER_DURABLE_NAME=nocu-consumer
CONSUMER_SUBJECTS=incident.>,job.>,monitor.>

# scheduler
SCHEDULER_JOB_TIMEOUT=5m
SCHEDULER_SLA_ACK_DEADLINE=15m
SCHEDULER_EVENT_RETENTION=720h
# how often the scheduler looks for monitors due for a probe
SCHEDULER_MONITOR_TICK=10s
# max probes run in parallel per tick
SCHEDULER_MONITOR_CONCURRENCY=10
# lets monitors target loopback/private IPs; off by default as an SSRF guard
SCHEDULER_MONITOR_ALLOW_PRIVATE=false
# how long monitor heartbeats are kept before cleanup
SCHEDULER_HEARTBEAT_RETENTION=720h
# days before certificate/domain expiry at which a warning event is published
SCHEDULER_EXPIRY_WARN_DAYS=7,14,30
