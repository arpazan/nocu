meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{identityUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.data.access_token);
    bru.setEnvVar("refreshToken", res.body.data.refresh_token);
  }
}

assert {
  res.status: eq 200
  res.body.data.token_type: eq Bearer
  res.body.data.access_token: isDefined
}

docs {
  Verifies credentials and returns a token pair. The post-response script stores
  both tokens in the active environment so every other request can inherit them.

  **200**
  ```json
  { "data": { "access_token": "...", "refresh_token": "...", "token_type": "Bearer", "expires_in": 900 } }
  ```

  **401** `unauthorized` on wrong email or password (same message for both).
  **403** `forbidden` when the account is inactive.
}
