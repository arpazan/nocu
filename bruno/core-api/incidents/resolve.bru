meta {
  name: Update (resolve)
  type: http
  seq: 5
}

patch {
  url: {{coreApiUrl}}/api/v1/incidents/{{incidentId}}
  body: json
  auth: inherit
}

body:json {
  {
    "status": "resolved",
    "description": "Edge-01 rebooted, sessions re-established"
  }
}

assert {
  res.status: eq 200
  res.body.data.status: eq resolved
}
