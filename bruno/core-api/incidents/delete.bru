meta {
  name: Delete
  type: http
  seq: 7
}

delete {
  url: {{coreApiUrl}}/api/v1/incidents/{{incidentId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Soft-deletes the incident and publishes `incident.deleted` with `{ "id": "..." }`.
  Requires `admin`.

  **404** `not_found` when already deleted or unknown.
}
