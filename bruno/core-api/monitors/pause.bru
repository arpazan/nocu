meta {
  name: Pause
  type: http
  seq: 5
}

post {
  url: {{coreApiUrl}}/api/v1/monitors/{{monitorId}}/pause
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data.active: eq false
}

docs {
  Sets `active: false`; the scheduler stops probing until the monitor is resumed.
  Publishes `monitor.updated`. Requires `operator` or `admin`.

  **404** `not_found` when the monitor does not exist.
}
